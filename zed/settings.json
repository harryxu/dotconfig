// Documentation: https://zed.dev/docs/configuring-zed.
// Run the `open default settings` command to see default settings.
{
  "tab_size": 2,
  "cli_default_open_behavior": "new_window",
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent_buffer_font_size": 21.0,
  "agent_ui_font_size": 21.0,
  "theme": "macOS Classic Light",
  "edit_predictions": {
    "provider": "zed"
  },
  "icon_theme": "Material Icon Theme",
  "outline_panel": {
    "dock": "right"
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "google",
      "model": "gemini-3.5-flash"
    }
  },
  "ui_font_size": 21.0,
  "ui_font_family": "Inter",
  "buffer_font_size": 25,
  "buffer_font_family": "Iosevka Nerd Font",
  "format_on_save": "off",
  "soft_wrap": "editor_width",
  "project_panel": {
    "dock": "left",
    "auto_reveal_entries": false,
    "hide_hidden": false,
    "hide_gitignore": false
  },
  "file_scan_inclusions": ["node_modules", "**/node_modules"],
  "languages": {
    "JSON": { "format_on_save": "on" }
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },

  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "never"
  },

  "auto_install_extensions": {
    "alabaster": true,
    "angular": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "color-highlight": true,
    "dockerfile": true,
    "emmet": true,
    "fish": true,
    "git-firefly": true,
    "html": true,
    "ini": true,
    "java": true,
    "kdl": true,
    "less": true,
    "log": true,
    "lua": true,
    "macos-classic": true,
    "make": true,
    "material-icon-theme": true,
    "nginx": true,
    "nvim-nightfox": true,
    "php": true,
    "react-typescript-snippets": true,
    "scss": true,
    "snippets": true,
    "sql": true,
    "toml": true
  }
}
